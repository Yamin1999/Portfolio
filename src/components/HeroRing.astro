---
/**
 * A G.8032 ring: four nodes, links between them, and one link deliberately
 * blocked — the ring protection link. It's the topology the professional work
 * is actually about, so it earns its place as the one decorative element.
 */
---

<svg
  class="hero__ring"
  viewBox="0 0 200 200"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle
    cx="100"
    cy="100"
    r="94"
    stroke="currentColor"
    stroke-width="1"
    stroke-dasharray="3 6"
    opacity="0.45"></circle>
  <circle cx="100" cy="100" r="84" stroke="currentColor" stroke-width="1.5"
  ></circle>

  {/* Ring nodes */}
  <circle cx="100" cy="16" r="5" fill="currentColor"></circle>
  <circle cx="184" cy="100" r="5" fill="currentColor"></circle>
  <circle cx="100" cy="184" r="5" fill="currentColor"></circle>
  <circle cx="16" cy="100" r="5" fill="currentColor"></circle>

  {/* RPL: blocked in the idle state, which is what keeps the ring loop-free */}
  <g transform="rotate(45 100 100)">
    <line
      x1="100"
      y1="6"
      x2="100"
      y2="26"
      stroke="var(--ground-alt)"
      stroke-width="7"></line>
    <line
      x1="92"
      y1="16"
      x2="108"
      y2="16"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"></line>
  </g>
</svg>
