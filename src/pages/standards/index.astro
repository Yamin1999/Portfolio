---
import Base from '../../layouts/Base.astro';
import { getStandards, getStandardsByBody } from '../../lib/content';
import { url, asset } from '../../lib/url';

const all = await getStandards();
const groups = await getStandardsByBody();
const implementedCount = all.filter((entry) => entry.data.implemented).length;
const reports = all.filter((entry) => entry.data.document);
---

<Base
  title="Standards"
  description="Notes on the IEEE, ITU-T and IETF standards behind carrier Ethernet switching, written while implementing them."
>
  <div class="container sections">
    <div class="page-head">
      <p class="eyebrow">Standards</p>
      <h1>Reading the spec</h1>
      <p class="lede">
        Carrier Ethernet interoperability is decided by the document, not by the
        peer. If two vendors disagree about a timer or a state transition, the
        standard says who is wrong. These are my notes on the specifications
        behind the work, written while implementing them.
      </p>
    </div>

    <div class="stats">
      <div class="stat">
        <span class="stat__value">{all.length}</span>
        <span class="stat__label">Documented</span>
      </div>
      <div class="stat">
        <span class="stat__value">{implementedCount}</span>
        <span class="stat__label">Implemented in production</span>
      </div>
      <div class="stat">
        <span class="stat__value">{reports.length}</span>
        <span class="stat__label">Learning reports</span>
      </div>
      <div class="stat">
        <span class="stat__value">{groups.length}</span>
        <span class="stat__label">Standards bodies</span>
      </div>
    </div>

    {
      groups.map((group) => (
        <section class="section">
          <div class="section__head">
            <h2>{group.publisher}</h2>
          </div>
          <div class="card-grid">
            {group.entries.map((entry) => (
              <a class="card" href={url(`/standards/${entry.id}`)}>
                <div class="card__body">
                  <div class="card__meta">
                    <span class="chip chip--standard">
                      {entry.data.designation}
                    </span>
                    {entry.data.implemented && (
                      <span class="mono muted">Implemented</span>
                    )}
                  </div>
                  <h3 class="card__title">{entry.data.title}</h3>
                  <p class="card__summary">{entry.data.summary}</p>
                  <span class="eyebrow">{entry.data.area}</span>
                  <span class="card__more">
                    Read notes <span>-&gt;</span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    {
      reports.length > 0 && (
        <section class="section">
          <div class="section__head">
            <h2>Learning reports</h2>
          </div>
          <p class="lede">
            Formal write ups I produced while studying each specification, with
            state machines, message flows and the cases that are easy to get
            wrong. Read them in the browser or download the PDF.
          </p>
          <div class="report-grid">
            {reports.map((entry) => (
              <a class="report-card" href={url(`/standards/${entry.id}`)}>
                {entry.data.documentThumb && (
                  <img
                    class="report-card__thumb"
                    src={asset(entry.data.documentThumb)}
                    alt=""
                    width="900"
                    height="1165"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="report-card__meta">
                  <span class="chip chip--standard">
                    {entry.data.designation}
                  </span>
                  <span class="report-card__title">{entry.data.title}</span>
                  <span class="mono muted">
                    {entry.data.documentPages} pages
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <p class="note">
      These pages are my own notes and summaries. The standards themselves are
      copyrighted by their publishers and are not reproduced here; each page
      links to the publisher's official copy.
    </p>
  </div>
</Base>
