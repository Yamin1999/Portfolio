---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingMinutes } from '../../lib/content';

interface Props {
  post: CollectionEntry<'posts'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);
const data = post.data;

const all = await getPosts();
const index = all.findIndex((p) => p.id === post.id);
const newer = all[index - 1];
const older = all[index + 1];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.excerpt,
  datePublished: data.publishedAt.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: 'Yamin Haque' },
  keywords: data.tech.join(', '),
};
---

<Base
  title={data.title}
  description={data.excerpt}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="container sections">
    <div class="page-head">
      <span class="mono muted">
        {formatDate(data.publishedAt)}
        <span class="skill-group__sep">·</span>
        {readingMinutes(post.body)} min read
        <span class="skill-group__sep">·</span>
        {data.category}
      </span>
      <h1>{data.title}</h1>
      <p class="lede">{data.excerpt}</p>
      {
        data.tech.length > 0 && (
          <div class="chips">
            {data.tech.map((item) => (
              <span class="chip">{item}</span>
            ))}
          </div>
        )
      }
    </div>

    <article class="prose">
      <Content />
    </article>

    <nav class="pager" aria-label="Post navigation">
      {newer ? <a href={`/blog/${newer.id}`}>← {newer.data.title}</a> : <span />}
      {older && <a href={`/blog/${older.id}`}>{older.data.title} →</a>}
    </nav>
  </div>
</Base>
