---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HeroRing from '../components/HeroRing.astro';
import site from '../data/site.json';
import skills from '../data/skills.json';
import { getFeaturedProjects, getProjects, getPosts, formatDate } from '../lib/content';
import { url } from '../lib/url';

const featured = await getFeaturedProjects(3);
const allProjects = await getProjects();
const posts = site.sections.showBlog ? (await getPosts()).slice(0, 2) : [];

// Counted from the content rather than hard-coded, so the numbers can't drift
// out of date as projects are added.
const standardsCount = new Set(
  allProjects.flatMap((project) => project.data.standards),
).size;

const stats = [
  { value: '3 yr', label: 'Embedded C in production' },
  { value: String(allProjects.length), label: 'Case studies' },
  { value: String(standardsCount), label: 'Standards implemented' },
  { value: '170+', label: 'CP problems solved' },
];

const skillDigest = skills.groups.filter((group) =>
  ['Programming', 'Systems & RTOS', 'Networking', 'Debugging & Tools'].includes(
    group.category,
  ),
);

const sameAs = [
  site.social.github,
  site.social.linkedin,
  site.social.codeforces,
  site.social.leetcode,
].filter(Boolean);

// Person markup is what ties this site to your other profiles in search results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  email: `mailto:${site.email}`,
  url: Astro.site?.href,
  image: site.photo ? new URL(url(site.photo), Astro.site).href : undefined,
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Rajshahi University of Engineering & Technology',
  },
  knowsAbout: [
    'Embedded C',
    'Embedded Linux',
    'Layer 2 networking',
    'Carrier Ethernet',
    'ERPS (G.8032)',
    'VxWorks',
    'Kernel tracing',
  ],
  sameAs,
};
---

<Base jsonLd={jsonLd}>
  <section class="hero-band">
    <div class="container">
      <div class="hero">
        <div class="hero__text">
          {
            site.availability && (
              <p class="badge">
                <span class="badge__dot" />
                {site.availability}
              </p>
            )
          }
          <p class="hero__title">{site.title}</p>
          <h1 class="hero__name">{site.name}</h1>
          <p class="hero__intro">{site.heroIntro}</p>
          <div class="btn-row">
            <a class="btn btn--primary" href={url('/projects')}>View projects</a>
            <a class="btn" href={url(site.resume)} download>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              {site.resumeLabel}
            </a>
            <a class="btn" href={site.social.github} rel="me noopener">GitHub</a>
            <a class="btn" href={site.social.linkedin} rel="me noopener">
              LinkedIn
            </a>
          </div>
        </div>

        {
          site.photo && (
            <figure class="hero__figure">
              <HeroRing />
              <img
                class="hero__photo"
                src={url(site.photo)}
                width="640"
                height="640"
                alt={`${site.name}, ${site.title}`}
                fetchpriority="high"
                decoding="async"
              />
            </figure>
          )
        }
      </div>

      <div class="stats">
        {
          stats.map((stat) => (
            <div class="stat">
              <span class="stat__value">{stat.value}</span>
              <span class="stat__label">{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="container sections">
    <section class="section">
      <div class="section__head">
        <h2>Selected projects</h2>
        <a href={url('/projects')}>All projects →</a>
      </div>
      <div class="card-grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Current focus</h2>
      </div>
      <p class="lede">{site.currentFocus}</p>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Skills</h2>
        <a href={url('/about#skills')}>Full list →</a>
      </div>
      <div class="skill-grid">
        {
          skillDigest.map((group) => (
            <div class="skill-card">
              <div class="skill-card__head">
                <span class="eyebrow">{group.category}</span>
              </div>
              <div class="chips">
                {group.items.map((item) => (
                  <span class="chip">{item}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {
      posts.length > 0 && (
        <section class="section">
          <div class="section__head">
            <h2>Engineering notes</h2>
            <a href={url('/blog')}>All notes →</a>
          </div>
          <div class="post-list">
            {posts.map((post) => (
              <a class="post-item" href={url(`/blog/${post.id}`)}>
                <span class="mono muted">
                  {formatDate(post.data.publishedAt)}
                </span>
                <h3 class="post-item__title">{post.data.title}</h3>
                <p class="card__summary">{post.data.excerpt}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="section">
      <div class="section__head">
        <h2>Get in touch</h2>
      </div>
      <p class="lede">
        Open to embedded software and systems roles. The fastest way to reach me
        is <a href={`mailto:${site.email}`}>{site.email}</a>, or use the <a
          href={url('/contact')}>contact form</a
        >.
      </p>
    </section>
  </div>
</Base>
